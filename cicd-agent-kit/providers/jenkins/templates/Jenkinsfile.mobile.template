// Generated by cicd-agent-kit — project-configurable mobile Jenkins pipeline.
// Placeholders are replaced by generate_jenkins_pipeline.sh.
// Credential IDs are references only — never embed secret values.

pipeline {
  agent {
    label '__RUNNER_LABEL__'
  }

  options {
    timestamps()
    timeout(time: __TIMEOUT_MINUTES__, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'PRESET', choices: __PRESET_CHOICES__, description: 'Configuration preset (not necessarily production destination)')
    choice(name: 'DESTINATION', choices: ['artifacts-only', 'testflight', 'firebase_app_distribution', 'google_play'], description: 'Distribution destination')
    string(name: 'RELEASE_NOTES', defaultValue: '', description: 'Release notes')
    booleanParam(name: 'ENABLE_NOTIFICATIONS', defaultValue: false, description: 'Optional non-blocking notifications')
  }

  environment {
    CICD_PLATFORM = '__CICD_PLATFORM__'
    CICD_PROJECT_FILE = '__DEFAULT_PROJECT_FILE__'
    CICD_DEFAULT_SCHEME = '__DEFAULT_SCHEME__'
    CICD_GRADLE_DIR = '__CICD_GRADLE_DIR__'
    CICD_BUILD_TARGET = '__CICD_BUILD_TARGET__'
    // Credential bindings (IDs must exist in Jenkins credentials store)
    // FASTLANE_TEAM_ID = credentials('__CRED_FASTLANE_TEAM_ID__')
    // MATCH_PASSWORD = credentials('__CRED_MATCH_PASSWORD__')
    // GOOGLE_APPLICATION_CREDENTIALS content should be written to a temp file from credentials('__CRED_FIREBASE_SA__')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Detect') {
      steps {
        sh 'chmod +x ./scripts/detect_project_platform.sh || true'
        sh './scripts/detect_project_platform.sh --format human || true'
      }
    }

    stage('Dependencies') {
      when { expression { return __ENABLE_DEPS__ } }
      steps {
        sh '__DEPS_COMMAND__'
      }
    }

    stage('Verify lanes') {
      when { expression { return fileExists('fastlane/Fastfile') } }
      steps {
        sh './scripts/verify_fastlane_lanes.sh . __FASTLANE_PLATFORM__ __LANE_MODE__'
      }
    }

    stage('Build / Test') {
      steps {
        sh '__BUILD_COMMAND__'
      }
    }

    stage('Artifacts') {
      when { expression { return __ENABLE_ARTIFACTS__ } }
      steps {
        archiveArtifacts artifacts: '__ARTIFACT_GLOBS__', allowEmptyArchive: true
      }
    }

    stage('Distribute') {
      when { expression { return params.DESTINATION != 'artifacts-only' && __ENABLE_DISTRIBUTE__ } }
      steps {
        sh '__DISTRIBUTE_COMMAND__'
      }
    }
  }

  post {
    always {
      script {
        if (params.ENABLE_NOTIFICATIONS) {
          sh './scripts/notify.sh "' + currentBuild.currentResult.toLowerCase() + '" "' + env.BUILD_URL + '" "' + env.BRANCH_NAME + '" || true'
        }
      }
    }
  }
}
