# Copy to .notification.local.env and fill in real values (never commit the local file).
# cp .env.example .notification.local.env

# Notifications (optional — never required for build/trigger success)
TEAM_WEBHOOK_URL=
CICD_CHAT_PROVIDER=teams

# Platform (auto-detects ios | android | flutter | react-native)
CICD_PLATFORM=auto
# For Flutter / React Native: android or ios (ask if unconfirmed)
CICD_BUILD_TARGET=android

# iOS defaults (paths relative to repo root when possible)
CICD_PROJECT_FILE=__DEFAULT_PROJECT_FILE__
CICD_DEFAULT_SCHEME=__DEFAULT_SCHEME__
CICD_DEFAULT_CONFIGURATION=Debug
CICD_TEST_DESTINATION="platform=iOS Simulator,name=iPhone 16"

# Android / Flutter / React Native defaults
CICD_GRADLE_DIR=android
CICD_NODE_VERSION=20

# App identifier (bundle id / application id)
FASTLANE_BUNDLE_IDENTIFIER=__APP_IDENTIFIER__

# iOS signing (optional until signing/distribution capabilities are approved)
FASTLANE_TEAM_ID=
FASTLANE_ITC_TEAM_ID=
MATCH_GIT_URL=
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=
APP_STORE_CONNECT_API_KEY=
CICD_USE_MATCH=false
CICD_UPLOAD_TESTFLIGHT=false

# Android signing (release builds)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Firebase App Distribution (optional)
# Preferred: service account / ADC — set GOOGLE_APPLICATION_CREDENTIALS to a JSON key file path.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_APP_ID=
FIREBASE_GROUPS=testers
CICD_DISTRIBUTE_FIREBASE=false
# Compatibility only (limited / may be deprecated by Firebase CLI) — prefer ADC:
FIREBASE_CLI_TOKEN=
